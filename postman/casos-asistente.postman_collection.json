{
  "info": {
    "name": "Grupo 6 - Casos de Asistente",
    "description": "Casos de exito y de error del modulo de asistentes (CU-09 a CU-12; RN-08 y RN-09). Se ejecuta con el entorno 'Grupo 6 - Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear asistente (201)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
          "pm.test(\"normaliza el correo a minusculas\", () => pm.expect(pm.response.json().email).to.eql(pm.response.json().email.toLowerCase()));",
          "pm.environment.set(\"idAsistente\", pm.response.json().id);"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Asistente\",\n  \"apellido\": \"De Prueba {{$timestamp}}\",\n  \"email\": \"asistente.{{$timestamp}}@ues.edu.sv\",\n  \"telefono\": \"7000-0000\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "asistentes"] }
      }
    },
    {
      "name": "Listar asistentes (200)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
          "pm.test(\"devuelve un arreglo\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
        ] } }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "asistentes"] }
      }
    },
    {
      "name": "ERROR - Correo electronico duplicado (409)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
          "pm.test(\"aplica RN-09\", () => pm.expect(pm.response.json().message).to.contain(\"correo electronico ya esta registrado\"));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Azucena\",\n  \"apellido\": \"Castillo\",\n  \"email\": \"azucena.castillo@ues.edu.sv\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "asistentes"] }
      }
    },
    {
      "name": "ERROR - Correo con formato invalido (400)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
          "pm.test(\"detalla el campo email\", () => pm.expect(JSON.stringify(pm.response.json().details)).to.contain(\"email\"));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sin\",\n  \"apellido\": \"Correo\",\n  \"email\": \"no-es-un-correo\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "asistentes"] }
      }
    },
    {
      "name": "ERROR - Eliminar asistente con registros activos (409)",
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": [
          "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));",
          "pm.test(\"aplica RN-08\", () => pm.expect(pm.response.json().message).to.contain(\"registros activos\"));"
        ] } }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/asistentes/2", "host": ["{{baseUrl}}"], "path": ["api", "asistentes", "2"] }
      }
    }
  ],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:8080" }]
}
