        {
          "name": "08 - Registro duplicado (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"asistenteId\": {{idAsistente}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/eventos/{{idEvento}}/registros", "host": ["{{baseUrl}}"], "path": ["api", "eventos", "{{idEvento}}", "registros"] },
            "description": "RN-04: un asistente no puede tener dos registros activos en el mismo evento."
          },
