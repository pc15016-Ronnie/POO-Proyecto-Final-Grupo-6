          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"asistenteId\": {{idAsistente2}}\n}" },
            "url": { "raw": "{{baseUrl}}/api/eventos/{{idEvento}}/registros", "host": ["{{baseUrl}}"], "path": ["api", "eventos", "{{idEvento}}", "registros"] },
