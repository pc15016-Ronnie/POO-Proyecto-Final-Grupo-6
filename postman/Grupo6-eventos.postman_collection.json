          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/registros/{{idRegistro}}", "host": ["{{baseUrl}}"], "path": ["api", "registros", "{{idRegistro}}"] } },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } } ]
