            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Asistente\",\n  \"apellido\": \"Actualizado\",\n  \"email\": \"{{emailActualizado}}\",\n  \"telefono\": \"7000-1111\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/asistentes/{{idAsistente}}", "host": ["{{baseUrl}}"], "path": ["api", "asistentes", "{{idAsistente}}"] }
          },
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set(\"emailActualizado\", \"actualizado.\" + Date.now() + \"@ues.edu.sv\");"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));", "pm.test(\"actualiza el telefono\", () => pm.expect(pm.response.json().telefono).to.eql(\"7000-1111\"));"] } }
          ]
        },
        {
          "name": "ERROR - Crear con correo repetido (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Otro\",\n  \"apellido\": \"Asistente\",\n  \"email\": \"{{emailActualizado}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "asistentes"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));", "pm.test(\"aplica RN-09\", () => pm.expect(pm.response.json().message).to.contain(\"correo electronico ya esta registrado\"));"] } } ]
        },
        {
          "name": "ERROR - Correo con formato invalido (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sin\",\n  \"apellido\": \"Correo\",\n  \"email\": \"no-es-un-correo\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "asistentes"] }
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"] } } ]
        },
        {
          "name": "ERROR - Eliminar asistente con registros activos (409)",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/asistentes/{{idAsistente}}", "host": ["{{baseUrl}}"], "path": ["api", "asistentes", "{{idAsistente}}"] } },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));", "pm.test(\"aplica RN-08\", () => pm.expect(pm.response.json().message).to.contain(\"registros activos\"));"] } } ]
        }
      ]
    },
    {
      "name": "Registro",
