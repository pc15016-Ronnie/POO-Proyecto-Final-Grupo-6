            "description": "CU-16: disponibilidad de cupo."
          }
        },
        {
          "name": "07 - Listar asistentes del evento (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/eventos/{{idEvento}}/asistentes", "host": ["{{baseUrl}}"], "path": ["api", "eventos", "{{idEvento}}", "asistentes"] },
            "description": "CU-17: asistentes inscritos (activos)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
