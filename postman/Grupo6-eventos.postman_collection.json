          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));", "pm.test(\"solo se eliminan cancelados\", () => pm.expect(pm.response.json().message).to.contain(\"cancelados\"));"] } } ]
